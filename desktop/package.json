{
  "name": "doppel-desktop",
  "version": "1.0.0",
  "description": "doppel desktop",
  "main": "main.js",
  "scripts": {
    "dev": "concurrently \"npm run dev:vite\" \"wait-on http://localhost:5173 && electron .\"",
    "dev:vite": "vite src/renderer",
    "build:renderer": "vite build src/renderer",
    "build:win": "npm run build:renderer && electron-builder --win",
    "build:mac": "npm run build:renderer && electron-builder --mac",
    "build": "npm run build:renderer && electron-builder --mac --win"
  },
  "devDependencies": {
    "@types/react": "^19.2.15",
    "@types/react-dom": "^19.2.3",
    "@vitejs/plugin-react": "^4.3.0",
    "concurrently": "^8.2.2",
    "electron": "^31.0.0",
    "electron-builder": "^24.13.3",
    "vite": "^5.4.0",
    "wait-on": "^7.2.0"
  },
  "dependencies": {
    "@clerk/clerk-js": "^5.125.10",
    "react": "^18.3.0",
    "react-dom": "^18.3.0"
  }
}
