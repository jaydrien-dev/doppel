# Doppel Brain — Backend Environment Variables
# Copy to .env and fill in real values before running.

# ── LLM ──────────────────────────────────────────────────────────────────────
ANTHROPIC_API_KEY=
OPENAI_API_KEY=

# ── Database ─────────────────────────────────────────────────────────────────
# Neon: postgresql+asyncpg://user:pass@ep-xxx.region.aws.neon.tech/neondb?ssl=require
DATABASE_URL=postgresql+asyncpg://postgres:password@localhost:5432/doppel

# ── Redis (optional — leave blank to use in-memory fallback for local dev) ───
REDIS_URL=

# ── App ──────────────────────────────────────────────────────────────────────
APP_ENV=production         # development | staging | production
SECRET_KEY=change_me_in_production
APP_URL=https://doppel-pi.vercel.app

# ── Google OAuth (Gmail ingestion) ───────────────────────────────────────────
GOOGLE_CLIENT_ID=
GOOGLE_CLIENT_SECRET=
GOOGLE_REDIRECT_URI=https://doppel.up.railway.app/ingestion/gmail/callback

# ── Gmail Push (Pub/Sub) ─────────────────────────────────────────────────────
# GCP project Pub/Sub topic for Gmail push notifications.
# Format: projects/{project_id}/topics/{topic_name}
# Set up: https://developers.google.com/gmail/api/guides/push
GMAIL_PUBSUB_TOPIC=projects/your-gcp-project/topics/gmail-push
# Random secret used to verify Pub/Sub push messages.
# Set the same value as the token in your Pub/Sub push subscription URL:
# https://doppel.up.railway.app/ingestion/gmail/push-event?token=<this_value>
PUBSUB_VERIFICATION_TOKEN=

# ── Slack ─────────────────────────────────────────────────────────────────────
SLACK_CLIENT_ID=
SLACK_CLIENT_SECRET=
SLACK_SIGNING_SECRET=
SLACK_REDIRECT_URI=https://doppel.up.railway.app/slack/callback

# ── GitHub OAuth (commit/PR ingestion) ───────────────────────────────────────
GITHUB_CLIENT_ID=
GITHUB_CLIENT_SECRET=
GITHUB_REDIRECT_URI=https://doppel.up.railway.app/ingestion/github/callback

# ── Notion OAuth (page/doc ingestion) ────────────────────────────────────────
NOTION_CLIENT_ID=
NOTION_CLIENT_SECRET=
NOTION_REDIRECT_URI=https://doppel.up.railway.app/ingestion/notion/callback

# ── Stripe ───────────────────────────────────────────────────────────────────
STRIPE_SECRET_KEY=
STRIPE_WEBHOOK_SECRET=

# ── Recall.ai (meeting bot) ──────────────────────────────────────────────────
RECALL_API_KEY=
RECALL_API_BASE=https://us-east-1.recall.ai/api/v1

# ── ElevenLabs (voice) ───────────────────────────────────────────────────────
ELEVENLABS_API_KEY=

# ── CORS ─────────────────────────────────────────────────────────────────────
# Production: comma-separated list of allowed frontend origins.
# e.g. https://yourdomain.com,https://www.yourdomain.com,https://yourapp.vercel.app
# Leave blank in development (wildcard * is used automatically).
ALLOWED_ORIGINS=https://doppel-pi.vercel.app

# ── At-rest encryption (AES-256-GCM) ─────────────────────────────────────────
# Encrypts OAuth tokens (Gmail, Slack, GitHub, Notion) and email draft content.
# Generate a key: python -c "import os,base64; print(base64.urlsafe_b64encode(os.urandom(32)).decode())"
# Store in Railway secrets — NEVER commit to git. Without this set, data is stored plaintext.
ENCRYPTION_KEY=

# ── Admin ─────────────────────────────────────────────────────────────────────
# Your Clerk user ID — gates all /admin/* routes. Find it at dashboard.clerk.com → Users.
ADMIN_USER_ID=
